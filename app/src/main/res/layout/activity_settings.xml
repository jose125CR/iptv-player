<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

<!-- No maxWidth here: LinearLayout ignores it (it was a no-op), so the panel has always
     been full-bleed. Reading measure is constrained by settings_content_inset on the
     content column instead, which is 0dp everywhere except TV. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">

    <!-- Nav rail - hidden entirely until a provider is configured (see showProviderSettings()) -->
    <LinearLayout
        android:id="@+id/settingsNavRail"
        android:layout_width="@dimen/settings_nav_rail_width"
        android:layout_height="match_parent"
        android:background="@color/canvas_elevated"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="@dimen/settings_gap_xl"
            android:layout_marginBottom="@dimen/settings_gap_l"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_section"
            android:fontFamily="@font/inter_bold" />

        <!-- Scrollable so the rail never clips the last row under the Cancel/Save footer
             on shorter TV panels - this rail has no fixed height budget of its own. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/settings_gap_m"
                android:paddingBottom="@dimen/settings_gap">

                <!-- Collapse row - first in the rail, directly under the "Settings" title,
                     so the way out sits where the eye already is rather than below ten
                     rows of scroll. Collapses the whole rail (see collapseSettingsRail());
                     the floating settingsExpandRailButton pill is the way back. Not part
                     of the navRows/pane mapping - it selects no section. -->
                <LinearLayout
                    android:id="@+id/navCollapseRail"
                    style="@style/Widget.Lumora.SettingsNavRow"
                    android:background="@drawable/nav_rail_item_glass">
                    <ImageView
                        android:layout_width="@dimen/settings_nav_icon_size"
                        android:layout_height="@dimen/settings_nav_icon_size"
                        android:src="@drawable/ic_arrow_left"
                        android:tint="@color/nav_icon_tint" />
                    <TextView
                        style="@style/Widget.Lumora.SettingsNavLabel"
                        android:text="@string/settings_nav_collapse" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navGeneral" style="@style/Widget.Lumora.SettingsNavRow" android:tag="0" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_settings" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/general" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navPlayback" style="@style/Widget.Lumora.SettingsNavRow" android:tag="2" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_playback" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/playback" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navPrivacy" style="@style/Widget.Lumora.SettingsNavRow" android:tag="4" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_privacy" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/privacy" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navEpg" style="@style/Widget.Lumora.SettingsNavRow" android:tag="6" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_epg" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/epg_sources" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navDownloads" style="@style/Widget.Lumora.SettingsNavRow" android:tag="7" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_downloads" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/downloads" />
                </LinearLayout>

                <LinearLayout android:id="@+id/navAbout" style="@style/Widget.Lumora.SettingsNavRow" android:tag="9" android:background="@drawable/nav_rail_item_glass">
                    <ImageView android:layout_width="@dimen/settings_nav_icon_size" android:layout_height="@dimen/settings_nav_icon_size" android:src="@drawable/ic_about" android:tint="@color/nav_icon_tint" />
                    <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="@string/about" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Thin vertical divider -->
    <View
        android:id="@+id/settingsNavDivider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- Content pane - clipChildren/clipToPadding false throughout this chain (and on
         every scaling row below) so the focus_scale/focus_scale_flat scale-up (1.06x)
         doesn't get cropped by an ancestor's bounds. Clipped scale-up is what made a
         focused item's rounded-corner highlight look cut off / squared-off on whichever
         edge got clipped, differing by position - i.e. looked like it "changed shape". -->
    <ScrollView
        android:id="@+id/settingsContentScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/settings_pane_padding"
            android:paddingEnd="@dimen/settings_content_inset">

            <!-- Pane: General - Simple mode / Disable VOD toggles are added from
                 showProviderSettings (same dubCheckBoxRow pattern as the Filters pane). -->
            <LinearLayout
                android:id="@+id/paneGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/general" style="@style/TextAppearance.Lumora.SettingsTitle" />
            </LinearLayout>
<!-- Pane: Playback -->
            <LinearLayout
                android:id="@+id/panePlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/playback" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsRecordingStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recording_storage" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/settings_gap" android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settingsDecoderMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/playback_settings" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/settings_gap" android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settingsAvOffset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/av_offset"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/settings_text_body"
                        android:fontFamily="@font/inter_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: Privacy -->
            <LinearLayout
                android:id="@+id/panePrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/privacy" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsParentalPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:id="@+id/settingsParentalPinLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_parental_pin" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap_l"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_watch_history" android:textColor="@color/live_red" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: EPG Sources -->
            <LinearLayout
                android:id="@+id/paneEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/epg_sources" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsAddEpgSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_epg_source" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: Downloads -->
            <LinearLayout
                android:id="@+id/paneDownloads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/downloads" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <TextView
                    android:id="@+id/settingsDownloadsEmptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_downloads_yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/settings_text_body"
                    android:fontFamily="@font/inter_regular"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settingsDownloadsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>


            <!-- Pane: About -->
            <LinearLayout
                android:id="@+id/paneAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_gap_l" android:text="@string/about" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:background="@drawable/card_surface_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_gap_l">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/version" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                    <TextView android:id="@+id/settingsAppVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/settings_gap_m" android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settingsAppNameRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap_m"
                    android:background="@drawable/card_surface_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_gap_l">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/about_app_label" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_secondary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/settings_gap_m" android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settingsPlatformRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap_m"
                    android:background="@drawable/card_surface_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_gap_l">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/about_platform_label" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_platform_value" android:textColor="@color/text_secondary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_regular" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/settings_gap_m" android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/settingsCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap_m"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:id="@+id/settingsCheckUpdateLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/check_for_updates" android:textColor="@color/text_primary" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsResetDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/settings_row_padding_vertical"
                    android:layout_marginTop="@dimen/settings_gap_m"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale_flat">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sett_reset_device" android:textColor="@color/live_red" android:textSize="@dimen/settings_text_body" android:fontFamily="@font/inter_medium" />
                </LinearLayout>
            </LinearLayout>


        </FrameLayout>
    </ScrollView>

  </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/settingsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas_elevated"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/settings_gap_l">

        <LinearLayout
            android:id="@+id/settingsCancelButton"
            style="@style/Widget.Lumora.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/settings_row_padding_vertical"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/settings_pane_padding"
            android:stateListAnimator="@animator/focus_scale_flat">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/settings_text_subtitle"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsSaveButton"
            style="@style/Widget.Lumora.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/settings_row_padding_vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/settings_pane_padding"
            android:stateListAnimator="@animator/focus_scale_flat">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_text_subtitle"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

    <!-- Settings rail re-expand affordance: when the rail is collapsed, this is the only
         way back to the sections, so it is a labelled pill rather than a bare icon - same
         treatment sidebarExpandButton gives the collapsed category rail. Anchored top-start
         where the rail's own top-left corner was (and where the eye looks for navigation),
         drawn last so it overlays the content. Visibility is driven by
         applySettingsRailVisibility() alongside the rail's own, never by hand. Focusable so
         a D-pad user on the content's first row can reach it with one LEFT press. -->
    <LinearLayout
        android:id="@+id/settingsExpandRailButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_sidebar_expand_pill"
        android:clickable="true"
        android:contentDescription="@string/show_settings"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:stateListAnimator="@animator/focus_scale_flat"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_s"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_primary" />
    </LinearLayout>

</FrameLayout>
